# ===================================================
# SIH 2026 - Environment Variables Example
# Copy this file to .env and fill in your values
# ===================================================

# --- Database ---
POSTGRES_DB=sih_db
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
DATABASE_URL=postgresql+asyncpg://sih_user:sih_password@localhost:5432/sih_db

# --- JWT Security ---
JWT_SECRET=supersecretjwtkey2026sih_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI Provider ---
# Options: mock | openai | local
AI_PROVIDER=mock

# OpenAI (optional — only if AI_PROVIDER=openai)
OPENAI_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Environment ---
ENVIRONMENT=development

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Frontend ---
VITE_API_URL=http://localhost:8000
